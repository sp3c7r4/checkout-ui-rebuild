# Vite bakes these at build time.
# Versioned API base (includes /api/v1) - used by the app's axios client
VITE_SERVER_ORIGIN=https://api.example.com/api/v1
# Root API origin (no path) - used by better-auth at /api/auth
VITE_API_ORIGIN=https://api.example.com
# Telegram bot deep link shown on the QR page
VITE_TELEGRAM_BOT_URL=https://t.me/your_bot
